# ==============================================================================
# Today. & t.note Vercel / Production Deployment Environment Variables (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Backend (Auth, Database & RLS)
# ------------------------------------------------------------------------------
# Supabase 대시보드 -> Project Settings -> API에서 확인 가능
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# (선택) 서버사이드 전용 관리자 키 (필요 시)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------------------------------------------
# 2. 카카오 1초 간편 로그인 (Kakao OAuth)
# ------------------------------------------------------------------------------
# Kakao Developers 콘솔 -> 내 애플리케이션 -> 앱 키 (REST API 키)
# Redirect URI 등록 필수: https://[your-domain]/auth/callback?next=/workspace
KAKAO_CLIENT_ID=your-kakao-rest-api-key
KAKAO_CLIENT_SECRET=your-kakao-client-secret

# ------------------------------------------------------------------------------
# 3. 구글 캘린더 OAuth 실시간 동기화 (Google Calendar API)
# ------------------------------------------------------------------------------
# Google Cloud Console -> API 및 서비스 -> 사용자 인증 정보 -> OAuth 2.0 클라이언트 ID
# 승인된 리디렉션 URI 등록 필수: https://[your-domain]/api/auth/google/callback
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# ------------------------------------------------------------------------------
# 4. 서비스 도메인 설정 (Optional)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_BASE_URL=https://today.or.kr
NODE_ENV=production
